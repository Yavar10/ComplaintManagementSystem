# ==============================================================================
# SIH26264 Integrated Complaint Management System - Backend Environment Config
# ==============================================================================

# Database Connection (PostgreSQL)
# For embedded/local development runner:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inno_complaints?schema=public"

# Application Environment
NODE_ENV=development
PORT=5000

# Security & Authentication
JWT_SECRET=sih2026_super_secure_institutional_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Allowed Client Origin (Vite frontend)
CLIENT_URL=http://localhost:5173

# Evidence Upload Directory (Protected local disk)
UPLOAD_DIR=./uploads

# SLA Monitoring Background Interval (in minutes)
SLA_CHECK_INTERVAL_MINUTES=60
